{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVM 오탐 규칙",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "cves", "match", "reason", "evidence", "verified_by", "verified_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^FP-[0-9]{4}$" },
    "status": { "enum": ["active", "withdrawn"] },
    "cves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA(-[23456789cfghjmpqrvwx]{4}){3}|GO-[0-9]{4}-[0-9]{4,}|PYSEC-[0-9]{4}-[0-9]+)$" }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purl_type", "purl_name"],
      "properties": {
        "purl_type": { "type": "string", "pattern": "^[a-z][a-z0-9.+-]*$" },
        "purl_namespace": { "type": "string", "minLength": 1 },
        "purl_name": { "type": "string", "minLength": 1 },
        "versions": {
          "oneOf": [
            { "const": "*" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 10 },
        "en": { "type": "string", "minLength": 10 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https://" }
    },
    "verified_by": { "type": "string", "minLength": 2 },
    "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "withdrawn_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "withdrawn_reason": { "type": "string", "minLength": 5 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "withdrawn" } } },
      "then": { "required": ["withdrawn_at", "withdrawn_reason"] }
    }
  ]
}
